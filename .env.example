# ==============================================================
# Turso Database & Vercel Environment Variables
# Add these variables to your Vercel Project Settings > Environment Variables
# ==============================================================

# 1. Turso Database URL (from https://turso.tech dashboard or `turso db show <name>`)
# Example: libsql://nexus-hub-yourname.turso.io
TURSO_DATABASE_URL=

# 2. Turso Auth Token (generated via `turso db tokens create <name>`)
TURSO_AUTH_TOKEN=

# 3. Secret Admin Password for managing apps on Vercel
# You will enter this password in the Admin Panel to authenticate
ADMIN_PASSWORD=1234
