# ==============================================================
# Nexus Projects Hub - Environment Variables
# Configure these variables in Vercel Project Settings > Environment Variables
# or in a local .env file.
# ==============================================================

# 1. Admin Authentication Credentials
# Used to authenticate into /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here

# 2. Secret Key for JWT Signing
# A high-entropy random string used to sign session tokens securely
JWT_SECRET=nexus_super_secret_jwt_key_2026_change_in_production

# 3. Turso Database (Optional - for persistent cloud storage across serverless instances)
# Turso Database URL (from https://turso.tech dashboard or `turso db show <name>`)
# Example: libsql://nexus-hub-yourname.turso.io
TURSO_DATABASE_URL=

# 4. Turso Auth Token (generated via `turso db tokens create <name>`)
TURSO_AUTH_TOKEN=
